AI_PROVIDER=auto
SITE_URL=https://turist-nikitka.vercel.app

# OpenRouter: use a real key only in .env.local or Vercel env vars.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Groq free-tier API. This is Groq, not xAI Grok.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional xAI Grok. Official xAI API is credit/paid-account based, not a permanent free API.
XAI_API_KEY=
XAI_MODEL=grok-4-fast
